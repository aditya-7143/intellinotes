DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intellinotes
DATABASE_ECHO=false

JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data/notes
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

CORS_ORIGINS=["http://localhost:3000"]
# Semantic retrieval (independent of the chat model)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Native 2048-dimensional output; no dimension parameter is sent to Nemotron.
# Reuses OPENROUTER_API_KEY and OPENROUTER_BASE_URL above.
# Optional endpoint override: EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# For local embeddings: EMBEDDING_PROVIDER=ollama and EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.3
RAG_INDEX_MAX_ATTEMPTS=8
